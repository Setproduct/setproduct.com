# Resend API key for contact form emails
# Get yours at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxx

# Google Analytics 4 Measurement ID
# Example: G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=

# Canonical production origin for OG and schema URLs.
# Optional: falls back to VERCEL_URL on preview deployments
# and to the production domain otherwise.
# Example: https://www.setproduct.com
NEXT_PUBLIC_SITE_URL=
